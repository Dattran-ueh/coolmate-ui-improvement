@model DatPaper.Models.HoaDon
@using System.Globalization

@{
    ViewData["Title"] = "Giỏ hàng";
    var vietnamese = CultureInfo.GetCultureInfo("vi-VN");
}

<h1 class="h2 mb-3">Giỏ hàng của bạn</h1>

@if (TempData["CartMessage"] is string message)
{
    <div class="alert alert-warning" role="alert">
        @message
    </div>
}

@if (!Model.ChiTietHoaDons.Any())
{
    <div class="alert alert-info">
        Giỏ hàng đang trống.
    </div>

    <a asp-action="Index" class="btn btn-success">
        Chọn sản phẩm
    </a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.ChiTietHoaDons)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@line.ProductObj.ImagePath"
                                     alt="@line.ProductObj.Name"
                                     style="width:70px;height:70px;object-fit:contain;" />
                                <span>@line.ProductObj.Name</span>
                            </div>
                        </td>

                        <td class="text-nowrap">
                            @line.DonGia.ToString("N0", vietnamese) đ
                        </td>

                        <td>
                            <form asp-action="UpdateCart"
                                  method="post"
                                  class="d-flex flex-wrap gap-2">
                                <input type="hidden"
                                       name="id"
                                       value="@line.MaProduct" />

                                <input type="number"
                                       name="quantity"
                                       value="@line.SoLuong"
                                       min="1"
                                       max="@line.ProductObj.Stock"
                                       step="1"
                                       aria-label="Số lượng @line.ProductObj.Name"
                                       class="form-control"
                                       style="width:85px;"
                                       required />

                                <button type="submit"
                                        class="btn btn-outline-primary btn-sm">
                                    Cập nhật
                                </button>
                            </form>
                        </td>

                        <td class="text-nowrap">
                            @((line.SoLuong * line.DonGia)
                                .ToString("N0", vietnamese)) đ
                        </td>

                        <td>
                            <form asp-action="RemoveFromCart" method="post">
                                <input type="hidden"
                                       name="id"
                                       value="@line.MaProduct" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Tổng tiền:</th>
                    <th colspan="2" class="text-success text-nowrap">
                        @Model.TongTien.ToString("N0", vietnamese) đ
                    </th>
                </tr>
            </tfoot>
        </table>
    </div>

    <a asp-action="Index" class="btn btn-outline-success">
        Tiếp tục mua sắm
    </a>
    <a asp-action="Checkout" class="btn btn-success">
    Tiến hành đặt hàng
</a>
}